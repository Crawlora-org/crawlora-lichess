    "/lichess/puzzle/batch": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns puzzles selected by an open-ended source theme/angle. Difficulty is easiest, easier, normal, harder, or hardest; color is white or black; nb is 1 through 50, default 15. The response may be an array. Player names, account identifiers, and PGN identity headers are omitted.",
        "operationId": "lichess-puzzle-batch",
        "parameters": [
          {
            "description": "Open-ended upstream puzzle theme",
            "in": "query",
            "name": "angle",
            "required": true,
            "type": "string"
          },
          {
            "description": "Optional source difficulty",
            "enum": [
              "easiest",
              "easier",
              "normal",
              "harder",
              "hardest"
            ],
            "in": "query",
            "name": "difficulty",
            "type": "string"
          },
          {
            "description": "Number of puzzles, 1 through 50 (default 15)",
            "in": "query",
            "name": "nb",
            "type": "integer"
          },
          {
            "description": "Optional side to move",
            "enum": [
              "white",
              "black"
            ],
            "in": "query",
            "name": "color",
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Get a Lichess puzzle batch by theme",
        "tags": [
          "lichess"
        ]
      }
    },
