    "/lichess/tablebase": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns tablebase information and legal moves for one FEN using the selected public ruleset. Supported variants are standard, atomic, and antichess. No game or player account is involved.",
        "operationId": "lichess-tablebase",
        "parameters": [
          {
            "description": "Tablebase ruleset",
            "enum": [
              "standard",
              "atomic",
              "antichess"
            ],
            "in": "query",
            "name": "variant",
            "required": true,
            "type": "string",
            "x-example": "standard"
          },
          {
            "description": "Position in Forsyth-Edwards Notation",
            "in": "query",
            "name": "fen",
            "required": true,
            "type": "string",
            "x-example": "8/8/8/8/8/8/1K6/6k1 w - - 0 1"
          },
          {
            "description": "Standard tablebase distance-to-conversion mode",
            "enum": [
              "never",
              "auxiliary",
              "always"
            ],
            "in": "query",
            "name": "dtc",
            "type": "string"
          }
        ],
