                  "$ref": "#/definitions/app.Response"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/lichess.EnumsResponse"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "List Lichess public read enums",
        "tags": [
          "lichess"
        ]
      }
    },
