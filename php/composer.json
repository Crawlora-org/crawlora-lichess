{
  "name": "crawlora/lichess",
  "description": "Crawlora Lichess API client with 11 endpoints for puzzles, tablebases, tournaments, cloud evaluations, and public event listings",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "lichess",
    "lichess-api",
    "lichess-scraper",
    "lichess-data",
    "lichess-puzzles",
    "lichess-tablebases",
    "lichess-tournaments",
    "lichess-cloud-evaluations",
    "lichess-public-event-listings"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Lichess\\": "src/Crawlora/Lichess/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Lichess\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=lichess-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-lichess",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=lichess-php-api-docs"
  }
}
