{
  "name": "@crawlora-org/lichess",
  "version": "0.1.0",
  "description": "Crawlora Lichess API client with 11 endpoints for puzzles, tablebases, tournaments, cloud evaluations, and public event listings",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=lichess-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-lichess/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "lichess", "lichess-api", "lichess-scraper", "lichess-data", "lichess-puzzles", "lichess-tablebases", "lichess-tournaments", "lichess-cloud-evaluations", "lichess-public-event-listings"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-lichess",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
